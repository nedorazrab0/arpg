/*
    Content-Security-Policy: style-src 'self'; default-src 'self'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; require-trusted-types-for 'script'; frame-ancestors 'none'; upgrade-insecure-requests;
    Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
    Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
    Referrer-Policy: strict-origin-when-cross-origin
    Cross-Origin-Embedder-Policy: require-corp
    Cross-Origin-Resource-Policy: same-origin
    Cross-Origin-Opener-Policy: same-origin
    Cache-Control: public, max-age=31536000
    Upgrade-Insecure-Requests: 1
    X-Content-Type-Options: nosniff
    X-Frame-Options: DENY

/*.html
    Cache-Control: no-cache

/
    Content-Security-Policy: style-src 'sha256-xb0o3S4xTLddx+PRqAsYJb6oXzATORDoK06Mi0JUues=';

/404
    Content-Security-Policy: style-src 'sha512-a';
    X-Robots-Tag: noindex
